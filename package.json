{
  "name": "@trybiut/mcp",
  "version": "0.1.0",
  "description": "TryBiut MCP server — AI agents can query taxes, invoices, pricing and reports. Public basic queries, private data requires TRYBIUT_API_TOKEN.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trybiut/trybiut-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "trybiut",
    "taxes",
    "autonomos",
    "freelance",
    "ai-agents",
    "claude",
    "cursor"
  ],
  "bin": {
    "trybiut-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "node scripts/smoke.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.7.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
