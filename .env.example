# Copy to .env — never commit real tokens.
TRYBIUT_BASE_URL=https://trybiut.com
# Optional. Without it only public (basic) tools work.
# Get it at https://trybiut.com/dashboard/api-tokens (logged in) and paste the access token here.
TRYBIUT_API_TOKEN=
# Optional: fail auth tools unless the account has an active subscription.
TRYBIUT_REQUIRE_SUBSCRIPTION=false
